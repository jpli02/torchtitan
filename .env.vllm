# .env.vllm -- environment for the vLLM + EvalPlus Ouro-1.4B HumanEval run.
#
# Why this exists: `run_ouro_vllm_humaneval.slurm` failed at *import* time with
#   ImportError: libcudart.so.13: cannot open shared object file
# vLLM's compiled `_C` extension is built against CUDA 13, but the venv ships the
# cu13 runtime under nvidia/cu13/lib/ which was not on LD_LIBRARY_PATH (only the
# system CUDA 12.8 from the cudatoolkit module was). This file puts the venv's
# cu13 libs first so the CUDA-13 sonames resolve, before ever touching the model.
#
# Usage: `set -a; source .env.vllm; set +a` (the slurm script does this).

# --- vLLM venv (single source of truth for the paths below) ---
VLLM_VENV=/work/hdd/bdjz/jli37/venvs/vllm

# --- CUDA 13 runtime resolution ---
# Prepend every nvidia/*/lib dir from the vLLM venv, cu13/lib FIRST so its
# libcudart.so.13 / libcublas.so.13 / etc. win over the cu12 copies. Falls back
# to the existing LD_LIBRARY_PATH (system CUDA, cray libs) after.
_VLLM_SP="${VLLM_VENV}/lib/python3.12/site-packages"
_VLLM_NVIDIA_LIBS="${_VLLM_SP}/nvidia/cu13/lib"
for _d in "${_VLLM_SP}"/nvidia/*/lib; do
    case ":${_VLLM_NVIDIA_LIBS}:" in
        *":${_d}:"*) ;;                                  # already added (cu13)
        *) _VLLM_NVIDIA_LIBS="${_VLLM_NVIDIA_LIBS}:${_d}" ;;
    esac
done
export LD_LIBRARY_PATH="${_VLLM_NVIDIA_LIBS}:${LD_LIBRARY_PATH:-}"
unset _d _VLLM_SP _VLLM_NVIDIA_LIBS

# --- vLLM / HF runtime knobs (mirrors the slurm script) ---
export HF_HOME=${HF_HOME:-/work/nvme/bdjz/jli37/hf_cache}
export HF_ALLOW_CODE_EVAL=1
export TOKENIZERS_PARALLELISM=false
export VLLM_WORKER_MULTIPROC_METHOD=spawn

# Ouro (LoopLM) is a custom architecture -> EvalPlus/vLLM must trust remote code.
export VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# Ouro recurrence: vLLM has no adaptive early-exit, so it always runs the full
# total_ut_steps=4 -- exactly the paper's R=4 reference. These are read from the
# HF config.json; documented here for clarity.
export OURO_TOTAL_UT_STEPS=4
export OURO_EARLY_EXIT_THRESHOLD=1.0
